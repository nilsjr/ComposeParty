{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'helpers:automergeDigests',
  ],
  baseBranchPatterns: [
    'develop',
  ],
  schedule: [
    'before 5am on saturday',
  ],
  packageRules: [
    {
      groupName: 'Kotlin & KSP',
      matchPackageNames: [
        '/^org.jetbrains.kotlin/',
        '/^com.google.devtools.ksp/',
      ],
    },
    {
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
  ],
}
